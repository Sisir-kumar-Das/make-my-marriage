NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Private values belong only in .env. Never commit the populated file.
# Atlas: Connect > Drivers. Use a database user, not your Atlas account login.
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage_dev

# Gmail SMTP: enter the account and its separate Google App Password privately.
# Spaces in the 16-character App Password are removed automatically.
EMAIL_PROVIDER=gmail
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional alternative: EMAIL_PROVIDER=resend uses only the settings below.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <onboarding@resend.dev>"

AUTH_VERIFICATION_TTL_HOURS=24
AUTH_VERIFICATION_COOLDOWN_SECONDS=45
AUTH_RATE_LIMIT_MAX=10

# Generate a random 48-byte secret locally; keep it only in .env.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
# Local HTTP uses lax; cross-site production HTTPS may need none.
AUTH_COOKIE_SAME_SITE=lax

# Password reset links: single use; maximum 30 minutes
AUTH_RESET_TTL_MINUTES=30
AUTH_RESET_COOLDOWN_SECONDS=45

# Private R2 account/bucket shared by dev and prod; NODE_ENV chooses the prefix.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=make-my-marriage-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
