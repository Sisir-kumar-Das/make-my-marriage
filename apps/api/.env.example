NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Private values belong only in .env. Never commit the populated file.
# Atlas: Connect > Drivers. Use a database user, not your Atlas account login.
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage_dev

# Resend API key and an address on your verified sending domain.
RESEND_API_KEY=
EMAIL_FROM="Make My Marriage <onboarding@resend.dev>"

AUTH_VERIFICATION_TTL_HOURS=24
AUTH_VERIFICATION_COOLDOWN_SECONDS=45
AUTH_RATE_LIMIT_MAX=10

# Generate a random 48-byte secret locally; keep it only in .env.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
# Local HTTP uses lax; cross-site production HTTPS may need none.
AUTH_COOKIE_SAME_SITE=lax
