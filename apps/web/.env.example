# Server-only Express target. Browser requests use the same-origin /api/v1 relay.
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Browser-visible key: restrict to Maps JavaScript API + Places API (New),
# and to your exact development/production website origins. Never use a server key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
