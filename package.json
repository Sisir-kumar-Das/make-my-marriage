{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@make-my-marriage/web --",
    "dev:api": "npm run dev --workspace=@make-my-marriage/api",
    "build": "npm run build --workspace=@make-my-marriage/web --",
    "start:web": "npm run start --workspace=@make-my-marriage/web --",
    "start:api": "npm run start --workspace=@make-my-marriage/api",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test scripts/api-client.test.mjs scripts/auth.test.mjs",
    "test:auth:db": "node --env-file-if-exists=apps/api/.env --test scripts/auth-db.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "^9.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
